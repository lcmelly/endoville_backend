{
  "builds": [
    {
      "src": "src/core/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/docs",
      "dest": "/docs/index.html"
    },
    {
      "src": "/docs/",
      "dest": "/docs/index.html"
    },
    {
      "src": "/docs/(.+)/",
      "dest": "/docs/$1/index.html"
    },
    {
      "src": "/docs/(.*)",
      "dest": "/docs/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "src/core/wsgi.py"
    }
  ]
}
