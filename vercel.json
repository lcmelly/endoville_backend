{
  "builds": [
    {
      "src": "src/core/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
 "headers": [
  {
    "source": "/(.*)",
    "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://endovillehealth.com" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
  }
 ]
}
