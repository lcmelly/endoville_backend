# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (if using PostgreSQL in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ZeptoMail & email templates (match python-decouple keys in core/settings.py)
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME=Endoville Health
ZOHO_ZEPTOMAIL_API_KEY_TOKEN=
ZOHO_ZEPTOMAIL_HOSTED_REGION=zeptomail.zoho.com
ZEPTOMAIL_OTP_TEMPLATE_KEY=
# Login OTP (code login); if empty, falls back to ZEPTOMAIL_OTP_TEMPLATE_KEY
ZEPTOMAIL_OTP_LOGIN_TEMPLATE_KEY=
ZEPTOMAIL_ORDER_CONFIRMATION_TEMPLATE_KEY=
# Abandoned cart reminder (ZeptoMail template key); leave empty to skip sending
ZEPTOMAIL_CART_REMINDER_TEMPLATE_KEY=
# Cart reminder CTA merge tag {{cart_url}} — full URL to your storefront cart page
FRONTEND_CART_URL=https://your-frontend.example.com/cart
# django-background-tasks: seconds between each abandoned-cart reminder job run (repeating schedule)
ABANDONED_CART_REMINDER_BG_INTERVAL_SECONDS=1800
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# OTP Settings
OTP_EXPIRY_MINUTES=10
