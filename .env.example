# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra browser origins. https://endovillehealth.com and https://www.endovillehealth.com are always allowed.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database. Leave DATABASE_URL empty to use SQLite at src/db.sqlite3.
# Production:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL_REQUIRE defaults to true when DEBUG is false.
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

# ZeptoMail & email templates (match python-decouple keys in core/settings.py)
DEFAULT_FROM_EMAIL=noreply@example.com
DEFAULT_FROM_NAME=Endoville Health
ZOHO_ZEPTOMAIL_API_KEY_TOKEN=
ZOHO_ZEPTOMAIL_HOSTED_REGION=zeptomail.zoho.com
ZEPTOMAIL_OTP_TEMPLATE_KEY=
# Login OTP (code login); if empty, falls back to ZEPTOMAIL_OTP_TEMPLATE_KEY
ZEPTOMAIL_OTP_LOGIN_TEMPLATE_KEY=
ZEPTOMAIL_ORDER_CONFIRMATION_TEMPLATE_KEY=
# Abandoned cart reminder (ZeptoMail template key); leave empty to skip sending
ZEPTOMAIL_CART_REMINDER_TEMPLATE_KEY=2d6f.4c0319d9e51623f5.k1.17c177c1-3deb-11f1-9420-525400a229b1.19db2d10135
# Cart reminder CTA merge tag {{cart_url}} — full URL to your storefront cart page
FRONTEND_CART_URL=https://your-frontend.example.com/cart
# Storefront origin for password-reset links. No trailing slash.
FRONTEND_URL=https://endovillehealth.com
# Optional ZeptoMail template for password reset. Empty sends an HTML email.
ZEPTOMAIL_PASSWORD_RESET_TEMPLATE_KEY=
# django-background-tasks: seconds between each abandoned-cart reminder job run (repeating schedule)
ABANDONED_CART_REMINDER_BG_INTERVAL_SECONDS=1800
SUPPORT_EMAIL=
SUPPORT_PHONE=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# OTP Settings
OTP_EXPIRY_MINUTES=10

# Stripe Checkout. The secret key itself lives in Payment credentials, not here.
# Shoppers send their own return URLs. These are the fallback when a client does not.
STRIPE_SUCCESS_URL=http://localhost:3000/orders?payment=success
STRIPE_CANCEL_URL=http://localhost:3000/orders?payment=failed
# Signing secret printed by `stripe listen` (local) or the Dashboard endpoint (deployed).
STRIPE_WEBHOOK_SECRET=
